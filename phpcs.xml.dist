<?xml version="1.0"?>
<ruleset name="myCred Amelia WordPress Standards">
	<description>PHPCS configuration for the myCred Amelia plugin</description>

	<!-- Scan all files in the current directory and subdirectories -->
	<file>.</file>

	<!-- Exclude directories -->
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>assets/build/*</exclude-pattern>
	<exclude-pattern>assets/libs/*</exclude-pattern>
	<exclude-pattern>.github/*</exclude-pattern>

	<!-- How to scan -->
	<arg value="sp"/> <!-- Show sniff and progress -->
	<arg name="colors"/> <!-- Show results with colors -->
	<arg name="basepath" value="."/> <!-- Strip the file paths down to the relevant bit -->
	<arg name="parallel" value="8"/> <!-- Enables parallel processing when available -->
	<arg name="extensions" value="php"/> <!-- Limit to PHP files -->

	<!-- Rules -->
	<!-- Include the WordPress ruleset -->
	<rule ref="WordPress">
		<!-- Exclude strict naming and file naming conventions for existing codebase -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName" />
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase" />
		<exclude name="WordPress.NamingConventions.ValidVariableName" />
		<exclude name="WordPress.NamingConventions.ValidClassName" />
		<exclude name="WordPress.NamingConventions.ValidFunctionName" />

		<!-- Exclude comment sniffs for existing codebase -->
		<exclude name="Squiz.Commenting" />

		<!-- Exclude code structure and alignment sniffs -->
		<exclude name="Generic.Files.OneObjectStructurePerFile" />
		<exclude name="WordPress.PHP.YodaConditions" />
		<exclude name="WordPress.Arrays.MultipleStatementAlignment" />
		<exclude name="Generic.Formatting.MultipleStatementAlignment" />
		<exclude name="WordPress.Formatting.MultipleStatementAlignment" />

		<!-- Exclude direct DB query & debug function warnings for custom tables/logging -->
		<exclude name="WordPress.DB.DirectDatabaseQuery" />
		<exclude name="WordPress.DB.PreparedSQL.InterpolatedNotPrepared" />
		<exclude name="WordPress.PHP.DevelopmentFunctions" />

		<!-- Exclude i18n comment requirement -->
		<exclude name="WordPress.WP.I18n.MissingTranslatorsComment" />
	</rule>

	<!-- Exclude PHPCompatibility forbidden names for legacy $object parameter -->
	<rule ref="PHPCompatibility.Keywords.ForbiddenNamesAsDeclared">
		<exclude name="PHPCompatibility.Keywords.ForbiddenNamesAsDeclared.objectFound" />
	</rule>

	<!-- Verify that the text_domain is set to the desired text-domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="mycred-amelia"/>
		</properties>
	</rule>

	<!-- PHP Compatibility -->
	<config name="testVersion" value="7.0-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
